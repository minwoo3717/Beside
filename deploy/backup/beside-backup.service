# Copies new H2 backups and new photos/GLBs from the beside-storage volume to the backup bucket, every 5 minutes
# (beside-backup.timer, REDUNDANCY Phase 1-1).
# Install: deploy/README.md '운영 대응 설치' (copies deploy/backup/offsite_backup.sh to /usr/local/sbin/beside-offsite-backup).
# Config: /etc/beside-backup.env (BUCKET=...). Logs: journalctl -u beside-backup. Run now: sudo systemctl start beside-backup
[Unit]
Description=Beside offsite backup (H2 zips, photos and GLBs every 5 minutes) to the backup bucket
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/beside-offsite-backup
# The 5-minute mode, together with STORAGE_BACKUP_CRON=0 */5 * * * * in deploy/.env (the backend's H2 backup):
# FORCE_FILES=1: photos and GLBs every run, not only at the day's first. Only files not in files.done go (a few new
#   ones per run); the find over uploads/ and results/ is the cost of a run.
# DB_STALE_MIN=20: the newest H2 zip older than 20 min (about 4 missed 5-minute backups) fails the run, so last.ok stops
#   and the VM watchdog reports it (BACKUP_STALE_S in beside-watchdog.service). Also the boot grace: not judged in the
#   first 20 min after a boot. With the backend still hourly this fails 40 min of each hour: set deploy/.env first.
Environment=FORCE_FILES=1
Environment=DB_STALE_MIN=20
# /var/lib/beside-backup: what was already sent (db.last, files.done, files.day). Passed as STATE_DIRECTORY.
StateDirectory=beside-backup
StateDirectoryMode=0700
SyslogIdentifier=beside-backup
# The first files run sends every photo and GLB at once; later runs send a zip and a few files. The timer starts no
# second run while one is going (and the script takes a lock).
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
PrivateTmp=yes
NoNewPrivileges=yes
