# Beside VM 앞단 프록시 (Caddy 2.11). deploy/docker-compose.yml 이 /etc/caddy/Caddyfile 로 넣는다.
# 환경변수는 compose 가 deploy/.env 에서 넘긴다: BESIDE_DOMAIN, BASIC_AUTH_USER, BASIC_AUTH_HASH, (선택) BACKEND_UPSTREAM, GRAFANA_UPSTREAM.
# 경로 규칙 표는 deploy/README.md '경로 규칙'. 규칙을 바꾸면 deploy/test_caddy_routes.sh 의 기대값도 같이 고친다.
#
# Caddy 매처 문법:
#   - 한 매처 블록 안의 서로 다른 조건(method 와 path)은 AND, 한 path 줄에 적은 여러 경로는 OR.
#   - path 는 대소문자를 가리지 않고, 퍼센트 인코딩을 풀고 ./.. 와 // 를 정리한 경로로 비교한다.
#   - * 는 끝(접두사), 앞(접미사), 양끝(부분 문자열), 가운데(한 경로 조각) 에 쓸 수 있다.
# 디렉티브는 적은 순서가 아니라 Caddy 의 정해진 순서로 돈다: request_body → basic_auth → respond → reverse_proxy.

{$BESIDE_DOMAIN} {
	# 업로드 본문 상한. Spring 은 요청 20MB(사진 5MB)를 넘으면 v1 오류 봉투로 413 을 주고,
	# 그보다 훨씬 큰 본문은 여기서 413 으로 끊는다(25MB = 25,000,000 바이트).
	request_body {
		max_size 25MB
	}

	# 응답 보안 헤더. HSTS: 한 번 HTTPS 로 온 브라우저는 이후 http:// 를 거치지 않는다(Basic 인증 정보가 평문으로 나가지 않게).
	# includeSubDomains·preload 는 넣지 않는다(duckdns.org 하위 이름 하나만 우리 것이다).
	header {
		Strict-Transport-Security "max-age=15552000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# 1) 없는 것처럼 404: v0 /api/jobs(동결, 서버 경로를 노출한다), H2 콘솔, Swagger UI, OpenAPI 문서, Actuator.
	#    /webjars: prod 에서도 Spring 의 기본 정적 경로가 springdoc 의 Swagger UI 묶음을 내준다(2026-11-13 감사에서 200 확인).
	#    Actuator 는 관리 포트 8081(compose 내부망, Prometheus 만 읽음)에 있어 공개 8080 에는 없다. 여기서 한 겹 더 막는다.
	#    경로에 ; 가 있으면 함께 막는다. Tomcat 은 /api/jobs;x 나 /api;x/v1/jobs 를 ; 뒤를 뺀 경로로 처리하므로
	#    ; 를 열어 두면 아래 인증 규칙과 이 404 규칙을 비켜 갈 수 있다. 앱과 웹은 ; 를 쓰지 않는다.
	@blocked path /api/jobs /api/jobs/* /h2-console* /swagger* /v3/api-docs* /webjars* /actuator* *;*
	respond @blocked 404

	# 2) Basic 인증(팀 계정 하나).
	#    웹 화면: Mock 업로드 UI(/ · /index.html · /app.js), 앞으로 생길 관리(/admin)·보관함(/library)·작업 상세(/job) 페이지,
	#    Grafana(/grafana, monitoring 프로필 — 이 인증 다음에 Grafana 자체 로그인이 한 번 더 있다).
	#    API: 관리(/api/v1/admin), 보관함(/api/v1/pets), 작업을 펫에 넣기(/api/v1/jobs/{id}/pet),
	#    품질 평가(웹 작업 상세만 쓴다, 팀 평가자 이름·의견), 공유 링크 만들기·모두 끊기(/api/v1/jobs/{id}/shares, 웹 작업 상세만
	#    쓴다. 앱은 아직 공유하지 않는다 — 앱 공유를 만들 때 공개로 바꿀지 다시 정한다).
	#    보관함에 쓰는 길은 모두 여기다: 공개 POST /api/v1/jobs 는 펫을 받지 않고(미분류로 만든다), 보관함 웹이 202 뒤에
	#    PUT /api/v1/jobs/{id}/pet 을 부른다.
	#    가운데 * 는 한 조각만 맞으므로 평가와 공유는 /ratings* · /ratings/* 와 /shares* · /shares/* 둘씩 적는다
	#    (PUT·DELETE 는 아래 @jobWrite 도 막는다).
	#    파일 이름에도 끝에 * 를 붙인다: Caddy 는 // 와 . 조각은 정리하지만 끝의 / 는 남기므로 /index.html/ 은 /index.html 과
	#    맞지 않는데, Spring 은 그것을 index.html 파일로 내준다(2026-11-13 감사에서 /index.html/ · /app.js/ 가 인증 없이 200).
	@web path / /index.html* /app.js* /admin* /library* /job* /grafana* /api/v1/admin* /api/v1/pets* /api/v1/jobs/*/pet* /api/v1/jobs/*/ratings* /api/v1/jobs/*/ratings/* /api/v1/jobs/*/shares* /api/v1/jobs/*/shares/*
	basic_auth @web {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	#    작업 목록(모든 작업과 GLB 가 보인다). 같은 경로의 POST(앱 업로드)만 공개다.
	#    "GET·HEAD 면 인증" 이 아니라 "POST 가 아니면 인증" 으로 쓴다: method 비교는 대소문자를 가려서
	#    get·head 같은 철자는 앞의 방식으로는 인증을 비켜 Spring 까지 간다(지금은 Spring 도 405 로 막지만 그것에 기대지 않는다).
	@jobList {
		path /api/v1/jobs /api/v1/jobs/
		not method POST
	}
	basic_auth @jobList {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	#    작업 하나에 대한 쓰기(삭제·평가 저장 등). 공개는 조회(GET·HEAD /api/v1/jobs/{id}, /asset)와 앱의 POST 둘
	#    (다시 시도 /retry, 대기 취소 /cancel — 앱이 쓰거나 쓸 것: CONTRACT §7)뿐이다. 둘 다 작업 UUID 를 아는 쪽만 부를 수 있다:
	#    UUID 는 그 작업을 만든 앱만 받고(202), 목록(@jobList)은 인증 뒤, 공유 링크 응답에는 jobId 가 없다.
	#    요청 수 제한은 없다(#22 RATE_LIMITED 는 이름만 예약, [계획]). 취소는 팀 알림(Discord)으로 보내지 않는다.
	@jobWrite {
		path /api/v1/jobs/*
		not method GET HEAD POST
	}
	basic_auth @jobWrite {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	#    공유 링크 취소(DELETE). 링크를 받은 사람이 끊지 못하게, 보는 쪽(GET·HEAD)만 공개다. @jobList 와 같은 이유로
	#    "DELETE 면 인증" 이 아니라 "GET·HEAD 가 아니면 인증" 으로 쓴다(method 비교는 대소문자를 가린다).
	@shareRevoke {
		path /api/v1/shares/*
		not method GET HEAD
	}
	basic_auth @shareRevoke {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	# 3) 그 밖은 공개: 앱 API(POST /api/v1/jobs, GET /api/v1/jobs/{id} · asset, POST retry · cancel), /api/v1/healthz,
	#    공유 링크 보기(/s/*, /share.*, GET /api/v1/shares/* — Scene Viewer 가 인증 없이 GLB 를 받는다), styles.css 같은 정적 파일.
	#    X-Forwarded-For/-Proto/-Host 는 Caddy 가 손님 값을 버리고 새로 붙인다(prod 프로파일의 forward-headers 가 읽는다).
	#    Spring 의 ForwardedHeaderFilter 는 그 밖에 Forwarded(RFC 7239, X-Forwarded-* 보다 먼저 읽음)와 X-Forwarded-Prefix·
	#    -Port·-Ssl 도 읽는데 Caddy 는 이것들을 그대로 넘긴다 → 손님이 Spring 이 보는 요청 URI·호스트를 바꿀 수 있다
	#    (2026-11-13 감사: X-Forwarded-Prefix 로 오류 응답 모양이 바뀜). 그래서 지운다(Grafana 쪽도 같이).
	#    /grafana* 만 Grafana 로 간다(위 @web 의 Basic 인증을 통과한 뒤). 경로 매처가 있는 reverse_proxy 가
	#    매처 없는 것보다 먼저 정렬되므로 적은 순서와 상관없이 이 규칙이 먼저다. 접두사 /grafana 는 떼지 않는다
	#    (GF_SERVER_SERVE_FROM_SUB_PATH=true). Basic 인증의 Authorization 헤더는 지운다: 남아 있으면 Grafana 가 그
	#    팀 계정을 자기 사용자로 검사해 401 을 준다.
	reverse_proxy /grafana* {$GRAFANA_UPSTREAM:grafana:3000} {
		header_up -Authorization
		header_up -Forwarded
		header_up -X-Forwarded-Prefix
		header_up -X-Forwarded-Port
		header_up -X-Forwarded-Ssl
	}
	reverse_proxy {$BACKEND_UPSTREAM:backend:8080} {
		header_up -Forwarded
		header_up -X-Forwarded-Prefix
		header_up -X-Forwarded-Port
		header_up -X-Forwarded-Ssl
	}

	# 접근 로그 → docker compose logs caddy. Authorization 헤더는 Caddy 가 기본으로 가린다.
	# 공유 링크(/s/{token}, /api/v1/shares/{token}[/asset])의 토큰은 링크의 유일한 비밀이라 앞 6자만 남긴다
	# (openapi revokeJobShares 의 '서버 로그에는 앞 6자만'. Spring 쪽은 GlobalExceptionHandler.pathForLog).
	# 공유 뷰어(share.html)는 no-referrer 라 Referer 헤더에는 토큰이 없다. test_caddy_routes.sh 가 확인한다.
	log {
		format filter {
			wrap json
			fields {
				request>uri regexp "(?i)^(/+(?:s|api/v1/shares)/+)([A-Za-z0-9_-]{6})[A-Za-z0-9_-]+" "$1$2..."
			}
		}
	}
}
