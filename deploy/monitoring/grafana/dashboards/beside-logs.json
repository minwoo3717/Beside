        "w": 24,
        "x": 0,
        "y": 45
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "beside-loki"
          },
          "refId": "A",
          "expr": "{service=~\".+\"} |= \"$q\"",
          "queryType": "range",
