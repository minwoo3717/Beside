          },
          "refId": "B",
          "expr": "sum(count_over_time({service=\"caddy\"} |= \"lt-$run-\" | json rid=`request.headers[\"X-Request-Id\"][0]`, status=\"status\" | rid=~\"lt-$run-.*\" | status >= 500 [1m]))",
          "legendFormat": "5xx/분",
          "queryType": "range"
        }
      ]
    }
