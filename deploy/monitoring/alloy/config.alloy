// Grafana Alloy 설정 (deploy/docker-compose.yml 의 alloy 서비스, profile monitoring).
// 하는 일: VM 의 Docker 로그 파일(json-file)을 읽어 Loki 로 보낸다. GPU Pod 가 보낸 로그(3500)·span(4320)도 받아 Loki·Tempo 로
// 넘긴다(맨 아래 'GPU Pod 로그·span 받는 곳', 2026-11-27).
// - docker.sock 을 쓰지 않는다(소켓은 :ro 여도 사실상 root 권한이다). 대신 compose 의 x-logging 이
//   json-file 의 labels 옵션으로 각 줄에 compose 서비스 이름(attrs."com.docker.compose.service")을 넣는다.
// - compose 밖 컨테이너(beside-stub 등)는 service="other" 로 들어간다.
// - backend(prod 는 JSON 로그)와 caddy(JSON 접근 로그)는 level 라벨을, backend 는 env 라벨(2026-11-27)도 뽑는다. jobId·uri 같은 값은
//   라벨로 만들지 않는다(라벨이 많아지면 Loki 가 느려진다). 질의 때 | json 으로 본다.
// 바꾼 뒤: docker compose -f deploy/docker-compose.yml --env-file deploy/.env --profile monitoring restart alloy

local.file_match "docker" {
  path_targets = [{"__path__" = "/var/lib/docker/containers/*/*-json.log"}]
  sync_period  = "15s"
}

loki.source.file "docker" {
  targets       = local.file_match.docker.targets
  forward_to    = [loki.process.docker.receiver]
  // 처음 뜰 때 옛 로그 전체를 다시 보내지 않는다. 읽은 위치는 --storage.path 볼륨에 남는다.
  tail_from_end = true
}

loki.process "docker" {
  forward_to = [loki.write.local.receiver]

  // Docker json-file 한 줄: {"log":"...\n","stream":"stdout","attrs":{...},"time":"..."}
  stage.json {
    expressions = {
      log     = "log",
      stream  = "stream",
      time    = "time",
      service = "attrs.\"com.docker.compose.service\"",
    }
  }

  stage.template {
    source   = "service"
    template = "{{ if .Value }}{{ .Value }}{{ else }}other{{ end }}"
  }

  stage.labels {
    values = {
      service = "",
      stream  = "",
    }
  }

  stage.timestamp {
    source = "time"
    format = "RFC3339Nano"
  }

  stage.output {
    source = "log"
  }

  // backend(prod JSON: "level":"ERROR") 와 caddy("level":"error") 의 수준을 대문자로 라벨에 둔다.
  // 텍스트 로그(prod 가 아닌 backend)는 level 이 없어 라벨도 없다.
  // backend 의 JSON 필드 env(prod | loadtest | local, 2026-11-27)도 라벨로 둔다: 알림이 부하 시험(loadtest) 줄에 울리지 않게.
  // 세 값 밖이나 env 가 없는 줄(옛 backend, caddy)은 라벨을 달지 않는다(라벨 값이 늘지 않게).
  stage.match {
    selector = "{service=~\"backend|caddy\"}"

    stage.json {
      source      = "log"
      expressions = {
        level = "level",
        env   = "env",
      }
    }

    stage.template {
      source   = "level"
      template = "{{ ToUpper .Value }}"
    }

    stage.template {
      source   = "env"
      template = "{{ if .Value }}{{ if eq .Value \"prod\" \"loadtest\" \"local\" }}{{ .Value }}{{ end }}{{ end }}"
    }

    stage.labels {
      values = {
        level = "",
        env   = "",
      }
    }
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ---- GPU Pod 로그·span 받는 곳 (2026-11-27) ----
// Runpod Pod 의 deploy/runpod/ship_logs.py 가 tailnet 으로 로그 줄을 Loki push 형식으로 3500 에, 추론 서비스(app.py)가 span 을
// OTLP/HTTP JSON 으로 4320 에 보낸다. compose 가 두 포트를 VM 에 게시한다(GCP 방화벽이 인터넷에서는 막는다 — docker-compose.yml).
// 받은 줄은 service="inference" 로 고정한다: tailnet 의 다른 기기가 보내도 backend·caddy 줄로 보일 수 없다(그쪽 알림을 울리거나
// 숨기지 못하게). 남기는 라벨은 service·file(inference.log 등)·host(Pod 의 tailnet 이름)·level·env(prod | loadtest) 뿐이다.
loki.source.api "pod" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 3500
  }
  // 보낸 쪽이 줄을 읽은 시각을 쓴다(묶어 보내거나 다시 보내도 시각이 그대로다).
  use_incoming_timestamp = true
  forward_to             = [loki.process.pod.receiver]
}

loki.process "pod" {
  forward_to = [loki.write.local.receiver]

  stage.static_labels {
    values = {
      service = "inference",
    }
  }

  // 수준은 줄 맨 앞에서 읽는다. 두 형식이 섞여 있다:
  //   app.py 의 로거  : 2026-11-26T01:02:03.456Z WARNING beside.inference ... rid=... trace=...
  //   uvicorn·셸 스크립트: WARNING:  ...  /  2026-11-26T01:02:03Z ERROR: ...(supervisor.log)
  // ship_logs.py 가 스택 줄을 앞 줄에 붙여 보내므로 ERROR 와 그 스택이 한 항목이고, 수준은 첫 줄에서 정해진다.
  stage.regex {
    expression = "^(?:\\d{4}-\\d{2}-\\d{2}T\\S+Z\\s+)?(?P<level>DEBUG|INFO|WARNING|WARN|ERROR|CRITICAL)(?::|\\s)"
  }

  // Python 의 WARNING·CRITICAL 을 backend 와 같은 WARN·ERROR 로 맞춘다(대시보드·알림이 level=~"ERROR|WARN" 로 본다).
  stage.template {
    source   = "level"
    template = "{{ if .Value }}{{ if eq .Value \"WARNING\" }}WARN{{ else if eq .Value \"CRITICAL\" }}ERROR{{ else }}{{ .Value }}{{ end }}{{ end }}"
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  stage.label_keep {
    values = ["service", "file", "host", "level", "env"]
  }
}

otelcol.receiver.otlp "pod" {
  // HTTP 만(gRPC 없음). 경로는 /v1/traces, 본문은 OTLP JSON 또는 protobuf.
  http {
    endpoint = "0.0.0.0:4320"
  }

  output {
    traces = [otelcol.exporter.otlphttp.tempo.input]
  }
}

otelcol.exporter.otlphttp "tempo" {
  // backend 와 같은 Tempo 의 OTLP HTTP(compose 내부망). /v1/traces 는 exporter 가 붙인다.
  client {
    endpoint = "http://tempo:4318"
    tls {
      insecure = true
    }
  }

  // 메모리 상한 384m 이라 대기열을 작게 둔다(Tempo 가 꺼져 있으면 넘친 span 은 버린다. Pod 쪽도 실패는 버린다).
  sending_queue {
    queue_size = 100
  }
}
