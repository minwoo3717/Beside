# deploy/.env 의 견본. VM 의 리포 루트에서 복사해 채운다(deploy/.env 는 .gitignore — 커밋하지 않는다):
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env && nano deploy/.env
# 값은 따옴표 없이 쓴다. 단 BASIC_AUTH_HASH 는 반드시 작은따옴표로 감싼다(아래 설명).

# 공개 도메인. VM 공인 IP 를 가리키는 A 레코드가 있어야 Caddy 가 Let's Encrypt 인증서를 받는다(예: DuckDNS).
BESIDE_DOMAIN=beside-example.duckdns.org

# 웹·관리 경로 Basic 인증 계정(팀 공용 하나).
BASIC_AUTH_USER=team
# 비밀번호의 bcrypt 해시. VM 에서 만든다(비밀번호 자체는 어디에도 저장하지 않는다):
#   docker run --rm caddy:2.11.7 caddy hash-password --plaintext '비밀번호'
# 출력 한 줄($2a$14$... 형태)을 작은따옴표 안에 그대로 붙인다. 작은따옴표가 없으면 docker compose 가
# $2a, $14 같은 부분을 변수로 해석해 해시가 깨지고 로그인이 영영 안 된다.
BASIC_AUTH_HASH='$2a$14$REPLACE.WITH.THE.OUTPUT.OF.caddy.hash-password.xxxxxxxxxxxxxxx'

# GPU PC 의 추론 서비스 주소: Tailscale IP(그 PC 에서 `tailscale ip -4`) + 포트.
INFERENCE_BASE_URL=http://100.64.0.10:8001
# 추론 서비스 토큰. GPU PC 의 BESIDE_INFERENCE_TOKEN 과 같은 값. 만드는 법: openssl rand -hex 32
INFERENCE_TOKEN=change-me-to-a-long-random-string

# (선택) Discord 웹훅: 작업 완성·실패, GPU 서버 연결/끊김을 팀 채널에 알린다. 비워 두면 알림을 보내지 않는다.
# 예: https://discord.com/api/webhooks/<id>/<token>
NOTIFY_WEBHOOK_URL=

# 모니터링(--profile monitoring)의 Grafana 관리자 계정. https://<도메인>/grafana/ 에서 Basic 인증 다음에 이 계정으로 로그인한다.
# 비밀번호가 비어 있으면 grafana 컨테이너는 뜨지 않는다(monitoring 을 안 쓰면 비워 둬도 된다). 만드는 법: openssl rand -base64 24
# 견본은 일부러 비워 둔다: 값을 적어 두면 복사한 .env 가 리포에 공개된 비밀번호로 Grafana 를 띄운다.
# 처음 뜰 때만 적용된다: 바꾸려면 README '모니터링'의 reset-admin-password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# 컨테이너에서 Tailscale 주소가 안 닿아 호스트 네트워크로 옮겼을 때만(docker-compose.yml 의 backend 주석).
# BACKEND_UPSTREAM=127.0.0.1:8080
# GRAFANA_UPSTREAM=127.0.0.1:3000
