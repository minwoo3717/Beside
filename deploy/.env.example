# deploy/.env 의 견본. VM 의 리포 루트에서 복사해 채운다(deploy/.env 는 .gitignore — 커밋하지 않는다):
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env && nano deploy/.env
# 값은 따옴표 없이 쓴다. 단 BASIC_AUTH_HASH 는 반드시 작은따옴표로 감싼다(아래 설명).

# 공개 도메인. VM 공인 IP 를 가리키는 A 레코드가 있어야 Caddy 가 Let's Encrypt 인증서를 받는다(예: DuckDNS).
BESIDE_DOMAIN=beside-example.duckdns.org

# 웹·관리 경로 Basic 인증 계정(팀 공용 하나).
BASIC_AUTH_USER=team
# 비밀번호의 bcrypt 해시. VM 에서 만든다(비밀번호 자체는 어디에도 저장하지 않는다):
#   docker run --rm caddy:2.11.7 caddy hash-password --plaintext '비밀번호'
# 출력 한 줄($2a$14$... 형태)을 작은따옴표 안에 그대로 붙인다. 작은따옴표가 없으면 docker compose 가
# $2a, $14 같은 부분을 변수로 해석해 해시가 깨지고 로그인이 영영 안 된다.
BASIC_AUTH_HASH='$2a$14$REPLACE.WITH.THE.OUTPUT.OF.caddy.hash-password.xxxxxxxxxxxxxxx'

# 추론 서비스 주소: GPU 쪽 Tailscale IP + 포트. Runpod Pod 는 deploy/runpod/start_pod.sh 가 마지막에 출력하는 값(포트 8002),
# GPU PC 는 그 PC 에서 `tailscale ip -4` 와 포트 8001. Pod 의 8001 은 Runpod 이미지의 nginx 라 쓰지 않는다.
INFERENCE_BASE_URL=http://100.64.0.10:8002
# 추론 서비스 토큰. GPU 쪽 BESIDE_INFERENCE_TOKEN 과 같은 값. 만드는 법: openssl rand -hex 32
INFERENCE_TOKEN=change-me-to-a-long-random-string

# (선택) 전처리 모델 폴더(VM 의 절대 경로). 비우면 리포의 backend/models. scripts/deploy_vm.sh 가 없으면 받는다.
# 리포 밖에 두면 git clean 으로 지워지지 않는다. 예: /opt/beside/models
BESIDE_MODELS_DIR=
# (선택) 대표 사진 검사·크롭/배경 제거를 끌 때만 false. 둘 다 false 면 모델을 받지 않는다.
PREPROCESS_CHECK_ENABLED=true
PREPROCESS_CUTOUT_ENABLED=true

# H2 온라인 백업(볼륨의 backup/beside-<시각>.zip): 주기(Spring cron, 초 분 시 일 월 요일, 한국 시각)와 남길 개수.
# 운영 VM 값은 5분마다·288개(하루 치, zip 하나 약 16 KB)다(REDUNDANCY Phase 1-1). 두 줄을 지우면 compose 기본값인
# 매시 5분·48개(application-prod.properties 와 같다)로 돈다.
# 이 값과 VM 밖 업로드(deploy/backup 의 5분 타이머, DB_STALE_MIN 20)는 함께 둔다: 백업이 매시인데 업로드가 5분 판이면
# 가장 새 zip 이 20분을 넘을 때마다 업로드가 실패로 끝나고 VM 감시가 🗄️ 를 보낸다. 순서는 README '운영 대응 설치' 4번.
STORAGE_BACKUP_CRON=0 */5 * * * *
STORAGE_BACKUP_KEEP=288

# (선택) 대기열 상한 — 안건 #21, 2026-11-21 결정(api-v1.1). 운영 VM 은 아래 두 줄을 주석으로 둔다(꺼 둠):
# QUEUE_FULL 을 아는 Unity 새 빌드를 팀·시연 기기에 깔고 5차 부하 시험이 N 을 확인한 뒤 켠다.
# 두 줄을 주석으로 두거나 ADMISSION_MAX_PENDING 을 0 으로 두면 꺼짐(compose 기본 0): 지금과 똑같이 받는다.
# 켜면(N > 0) 대기 작업 + 접수 중인 요청이 N 이상일 때 v1 생성·retry 를 503 QUEUE_FULL + Retry-After(R 초)로 바로 거절한다.
# - 켜기 전에 팀·시연 기기에 QUEUE_FULL 을 아는 새 앱 빌드를 깐다(옛 빌드는 "다시 시도할 수 없어요" 를 보인다).
# - N 과 R 은 함께 정한다. 목표 최악 대기 W, 슬롯 시간 S, 잰 처리량 mu(건/h)이면 N = floor(W/S) - 1, R = N*3600/mu.
#   c=1(inference.max-concurrency 1, A40 한 대)·W 180 s 로 정한 값은 N 19, R 165(docs/perf/load/2026-11-20_queue-cap.md 9절).
#   5차 부하 시험에서 S_busy 를 다시 재면(GLB 에 털 맵이 들어감) 같은 규칙으로 다시 계산할 수 있다.
#   inference.max-concurrency(슬롯 수)나 GPU 수가 바뀌면 N 과 R 을 함께 다시 계산한다.
# - 형식: N 은 0 이상 정수, R 은 1 이상 정수(초). 틀리면 backend 가 시작하지 못하고 재시작을 되풀이한다(운영 중단).
#   올리기 전에 형식을 본다(아무것도 출력되지 않으면 맞다):
#     grep -E '^ADMISSION_' deploy/.env | grep -vxE 'ADMISSION_MAX_PENDING=[0-9]*|ADMISSION_RETRY_AFTER_SECONDS=([1-9][0-9]*)?'
#   적용: docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d backend
#   확인: 같은 compose 명령의 logs backend | grep -E "Queue admission: (on|off)" | tail -1 → "on, max-pending=19 retry-after-seconds=165 ..."
#   (꺼짐이면 "off". 같은 머리말의 다른 줄은 실행 중 기록이라 시작 줄만 고른다)
# - 되돌리기: ADMISSION_MAX_PENDING=0 으로 바꾸고 같은 up -d backend. 부하 중에도 된다. 다시 띄울 때 대기·처리 중이던 작업은
#   FAILED(INTERNAL_ERROR)가 되는데, 상한이 켜져 있었으므로 많아야 N + c 건이고 앱에서 retry 할 수 있다.
# ADMISSION_MAX_PENDING=0
# ADMISSION_RETRY_AFTER_SECONDS=165

# (선택) Discord 웹훅: 작업 완성·실패, GPU 서버 연결/끊김을 팀 채널에 알린다. 비워 두면 알림을 보내지 않는다.
# 예: https://discord.com/api/webhooks/<id>/<token>
NOTIFY_WEBHOOK_URL=
# (선택) GPU 알림에 붙는 서버 이름. 예: "🟢 GPU 추론 서버(Runpod A40) 연결됨". 비우면 이름 없이 보낸다.
# 따옴표·$·# 없이 쓴다(` #` 뒤는 주석으로 잘린다).
# prod 는 GPU 끊김이 45초 넘게 이어질 때만 알린다(Tailscale 중계가 한 번 놓치는 것은 알리지 않음, notify.down-grace-ms).
NOTIFY_INFERENCE_LABEL=Runpod A40

# 모니터링(--profile monitoring)의 Grafana 관리자 계정. https://<도메인>/grafana/ 에서 Basic 인증 다음에 이 계정으로 로그인한다.
# 비밀번호가 비어 있으면 grafana 컨테이너는 뜨지 않는다(monitoring 을 안 쓰면 비워 둬도 된다). 만드는 법: openssl rand -base64 24
# 견본은 일부러 비워 둔다: 값을 적어 두면 복사한 .env 가 리포에 공개된 비밀번호로 Grafana 를 띄운다.
# 처음 뜰 때만 적용된다: 바꾸려면 README '모니터링'의 reset-admin-password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# (선택) 분산 추적의 표본 비율(2026-11-26 W8). 비우면 1.0 = 모든 요청·작업 실행의 트레이스를 tempo 로 보낸다.
# monitoring 프로필 없이(tempo 없이) 띄울 때나 부하 시험에서 줄일 때 0~1 로 둔다. 0 이면 보내지 않고 traceId 는 로그에 남는다.
# TRACING_SAMPLING_PROBABILITY=1.0

# 컨테이너에서 Tailscale 주소가 안 닿아 호스트 네트워크로 옮겼을 때만(docker-compose.yml 의 backend 주석).
# BACKEND_UPSTREAM=127.0.0.1:8080
# GRAFANA_UPSTREAM=127.0.0.1:3000
